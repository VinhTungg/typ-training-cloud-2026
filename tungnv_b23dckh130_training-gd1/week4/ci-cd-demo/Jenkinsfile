pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        DOCKER_HUB_USER = 'vinhtung'  // Docker Hub username của bạn
        IMAGE_NAME      = "${DOCKER_HUB_USER}/docker-cloud-demo"
        IMAGE_TAG       = "${BUILD_NUMBER}"
        DOCKER_CONFIG   = "${WORKSPACE}/.docker-auth"
        TARGET_VM_IP    = '10.97.0.118'  // IP thực tế của Target VM
        APP_DIR         = 'tungnv_b23dckh130_training-gd1/week4/ci-cd-demo'
        DOCKER_BUILDKIT = '1'
    }
    stages {
        stage('1. Checkout') {
            steps {
                echo '=== 1. Kiem tra ma nguon tu Git Repository ==='
                checkout scm
            }
        }
        stage('2. Docker Build') {
            steps {
                echo "=== 2. Dong goi anh Docker phien ban ${IMAGE_TAG} ==="
                script {
                    def targetDir = fileExists(env.APP_DIR) ? env.APP_DIR : '.'
                    dir(targetDir) {
                        sh '''
                            docker build \
                              -t "$IMAGE_NAME:$IMAGE_TAG" \
                              -t "$IMAGE_NAME:latest" \
                              -f app/Dockerfile app/
                        '''
                    }
                }
            }
        }
        stage('3. Docker Hub Push') {
            steps {
                echo '=== 3. Dang nhap va day anh len Docker Hub Registry ==='
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_TOKEN')]) {
                    sh '''
                        set -eu
                        mkdir -p "$DOCKER_CONFIG"
                        echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                        docker push "$IMAGE_NAME:$IMAGE_TAG"
                        docker push "$IMAGE_NAME:latest"
                        docker logout || true
                    '''
                }
            }
        }
        stage('4. Deploy') {
            steps {
                echo "=== 4. Trien khai Container len Target VM (${TARGET_VM_IP}) qua SSH ==="
                sshagent(credentials: ['target-vm-ssh-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=accept-new ubuntu@${TARGET_VM_IP} '
                            sudo docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                            sudo docker stop typ-web-app 2>/dev/null || true
                            sudo docker rm typ-web-app 2>/dev/null || true
                            sudo docker run -d --name typ-web-app --restart unless-stopped -p 3000:3000 ${IMAGE_NAME}:${IMAGE_TAG}
                        '
                    """
                }
            }
        }
        stage('5. Smoke Test') {
            steps {
                echo '=== 5. Kiem tra trang thai hoat dong thuc te tren Target VM ==='
                sh "curl --fail --show-error --retry 5 --retry-delay 2 http://${TARGET_VM_IP}:3000/healthz"
                sh "curl --fail --show-error http://${TARGET_VM_IP}:3000/"
            }
        }
    }
    post {
        always {
            sh 'rm -rf "$DOCKER_CONFIG" || true'
        }
        success {
            echo '=== CI/CD THANH CONG: Ung dung da duoc build, push va deploy len Target VM thanh cong! ==='
        }
        failure {
            echo '=== CI/CD THAT BAI: Vui long kiem tra Console Output ==='
        }
    }
}
