# ==============================================================================
# Multi-stage Dockerfile (Tối ưu hóa kích thước và bảo mật tối đa cho Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Dependencies Resolution (Sử dụng Image đầy đủ để cài đặt/build)
# ------------------------------------------------------------------------------
FROM node:20.18.0-alpine3.20 AS builder

WORKDIR /build

# Sao chép file cấu hình dependency
COPY package*.json ./

# Cài đặt chỉ production dependencies và dọn dẹp cache của npm
RUN npm ci --only=production && \
    npm cache clean --force

# Sao chép toàn bộ mã nguồn
COPY . .

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime (Sử dụng Alpine siêu nhẹ, loại bỏ công cụ thừa)
# ------------------------------------------------------------------------------
FROM node:20.18.0-alpine3.20 AS runner

LABEL maintainer="Nguyen Vinh Tung <B23DCKH130>" \
      project="TYP Cloud Training 2026" \
      version="1.0.0-multistage" \
      description="Optimized Multi-stage Dockerfile for Production"

ENV NODE_ENV=production \
    PORT=3000 \
    APP_VERSION=1.0.0-multistage

WORKDIR /app

# Chỉ sao chép node_modules và mã nguồn từ Stage builder sang
COPY --from=builder --chown=node:node /build/node_modules ./node_modules
COPY --from=builder --chown=node:node /build/src ./src
COPY --from=builder --chown=node:node /build/package.json ./package.json

# Khai báo cổng ứng dụng
EXPOSE 3000

# Chuyển quyền người dùng sang node (UID 1000) có sẵn trong Alpine image
USER node

# Cấu hình Healthcheck siêu nhẹ
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/healthz', (res) => { if (res.statusCode !== 200) process.exit(1); })"

# Chạy ứng dụng bằng Exec form
CMD ["node", "src/index.js"]
